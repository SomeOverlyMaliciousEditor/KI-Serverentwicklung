digraph app_schema {
  rankdir=LR;
  node [shape=plaintext];

  users [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0"><TR><TD COLSPAN="2" BGCOLOR="lightgrey"><B>users</B></TD></TR><TR><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT">PK</TD></TR><TR><TD ALIGN="LEFT">email</TD><TD ALIGN="LEFT">UNIQUE NOT NULL</TD></TR><TR><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT">NOT NULL</TD></TR></TABLE>>];
  profiles [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0"><TR><TD COLSPAN="2" BGCOLOR="lightgrey"><B>profiles</B></TD></TR><TR><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT">PK</TD></TR><TR><TD ALIGN="LEFT">user_id</TD><TD ALIGN="LEFT">FK→users UNIQUE NOT NULL</TD></TR><TR><TD ALIGN="LEFT">full_name</TD><TD ALIGN="LEFT">NOT NULL</TD></TR><TR><TD ALIGN="LEFT">bio</TD><TD ALIGN="LEFT"></TD></TR></TABLE>>];
  customers [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0"><TR><TD COLSPAN="2" BGCOLOR="lightgrey"><B>customers</B></TD></TR><TR><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT">PK</TD></TR><TR><TD ALIGN="LEFT">email</TD><TD ALIGN="LEFT">UNIQUE NOT NULL</TD></TR><TR><TD ALIGN="LEFT">name</TD><TD ALIGN="LEFT">NOT NULL</TD></TR><TR><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT">NOT NULL</TD></TR></TABLE>>];
  orders [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0"><TR><TD COLSPAN="2" BGCOLOR="lightgrey"><B>orders</B></TD></TR><TR><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT">PK</TD></TR><TR><TD ALIGN="LEFT">customer_id</TD><TD ALIGN="LEFT">FK→customers NOT NULL</TD></TR><TR><TD ALIGN="LEFT">ordered_at</TD><TD ALIGN="LEFT">NOT NULL</TD></TR><TR><TD ALIGN="LEFT">status</TD><TD ALIGN="LEFT">NOT NULL</TD></TR><TR><TD ALIGN="LEFT">total_cents</TD><TD ALIGN="LEFT">NOT NULL</TD></TR><TR><TD ALIGN="LEFT">version</TD><TD ALIGN="LEFT">NOT NULL DEFAULT 1</TD></TR></TABLE>>];

  users -> profiles [label="1:1 (UNIQUE FK)"];
  customers -> orders [label="1:N (FK, cascade)"];
}
